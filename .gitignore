home_assistant/ha/config/.ha_run.lock
home_assistant/ha/config/.HA_VERSION
home_assistant/ha/config/secrets.yaml
home_assistant/ha/config/.storage/*adbkey*
home_assistant/ha/config/.storage/*.pem
home_assistant/ha/config/.storage/*.pub
home_assistant/mosquitto/data/
home_assistant/mosquitto/log/
portainer/data/
