###############################################################################
# Paperless-ngx settings                                                      #
###############################################################################

# Match these to the UID/GID that should own mounted files on the host.
USERMAP_UID=1000
USERMAP_GID=1000

# Uncomment and customize if exposing Paperless on a public URL.
# PAPERLESS_URL=https://paperless.example.com

# Set a long random secret if exposing Paperless publicly.
# PAPERLESS_SECRET_KEY=replace-with-a-long-random-secret

# Container timezone.
PAPERLESS_TIME_ZONE=Asia/Beirut

# Default OCR language.
PAPERLESS_OCR_LANGUAGE=eng

# Additional OCR languages separated by spaces.
PAPERLESS_OCR_LANGUAGES=ara
