# Shared settings
TIMEZONE=Asia/Beirut
PI_IP=192.168.x.x

# Cloudflared
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# n8n
N8N_HOST=n8n.example.com
N8N_PUBLIC_URL=https://n8n.example.com/
N8N_WEBHOOKS_URL=https://hooks.example.com/

# ntfy
NTFY_BASE_URL=https://ntfy.example.com

# Diun
DIUN_NTFY_TOKEN=your-diun-ntfy-access-token
DIUN_NTFY_TOPIC=updates

# Twingate
TWINGATE_NETWORK=your-twingate-network
TWINGATE_ACCESS_TOKEN=your-twingate-access-token
TWINGATE_REFRESH_TOKEN=your-twingate-refresh-token
TWINGATE_LABEL_HOSTNAME=your-connector-hostname

# Jellyfin
JELLYFIN_PUBLIC_URL=https://watch.example.com
APPDATA_DIR=/srv/appdata
STORAGE_ROOT=/srv
MEDIA_ROOT=/srv/media
TV_DIR=/srv/media/tv
MOVIES_DIR=/srv/media/movies
DOWNLOADS_DIR=/srv/downloads
PUID=1000
PGID=1000
UMASK=002

# Kopia
KOPIA_REPOSITORY_PASSWORD=change-me
KOPIA_UI_USERNAME=kopia
KOPIA_UI_PASSWORD=change-me
