# Shared settings
TIMEZONE=Asia/Beirut
PI_IP=192.168.x.x

# Cloudflared
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# n8n
N8N_HOST=n8n.example.com
N8N_PUBLIC_URL=https://n8n.example.com/
N8N_WEBHOOKS_URL=https://hooks.example.com/

# Jellyfin
JELLYFIN_PUBLIC_URL=https://watch.example.com
APPDATA_DIR=/srv/appdata
MEDIA_ROOT=/srv/media
TV_DIR=/srv/media/tv
MOVIES_DIR=/srv/media/movies
DOWNLOADS_DIR=/srv/downloads
PUID=1000
PGID=1000
UMASK=002
